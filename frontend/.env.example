# COSTTY Frontend — Environment Configuration
#
# Copy this file to `.env` for local development, OR add these variables
# in Vercel's "Environment Variables" dashboard for production.

# Backend API URL (FastAPI server)
# Local: http://localhost:8000
# Production: https://your-app.onrender.com
VITE_API_URL=http://localhost:8000

# Supabase Configuration
# Get from: Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://CHANGE_ME.supabase.co
VITE_SUPABASE_ANON_KEY=CHANGE_ME
VITE_SUPABASE_STORAGE_BUCKET=documents
