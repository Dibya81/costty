# COSTTY Frontend — Environment Configuration
#
# The frontend talks ONLY to the FastAPI backend.
# Supabase is used exclusively by the backend (server-side).
# Copy this file to `.env` for local development, OR set these in
# Vercel's "Environment Variables" dashboard for production.

# Backend API URL (FastAPI server)
# Local: http://localhost:8000
# Production: https://your-app.onrender.com
VITE_API_URL=http://localhost:8000