# Application
APP_NAME="Document Platform"
APP_ENV=development
DEBUG=true

# Database - Supabase PostgreSQL
# Get this from Supabase Dashboard > Settings > Database > Connection string > URI
# Format: postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# Direct Supabase connection (for migrations and direct DB access)
SUPABASE_DB_URL=postgresql+psycopg://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# Supabase Configuration
# Get from Supabase Dashboard > Settings > API
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Supabase Storage
SUPABASE_STORAGE_BUCKET=documents

# Currency
CURRENCY=INR

# Default Pricing (per printed side, in INR)
BW_SIMPLEX_PRICE=2.50
BW_DUPLEX_PRICE=2.50
COLOR_SIMPLEX_PRICE=8.00
COLOR_DUPLEX_PRICE=8.00

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend-domain.vercel.app

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Admin
ADMIN_API_KEY=change-me-in-production

# JWT
JWT_SECRET=change-me-in-production-jwt
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# File Storage
STORAGE_BACKEND=supabase
STORAGE_LOCAL_PATH=./storage
MAX_UPLOAD_SIZE_BYTES=52428800
ALLOWED_FILE_EXTENSIONS=pdf,doc,docx,ppt,pptx,xls,xlsx,txt,csv,jpg,jpeg,png,gif,webp,bmp
