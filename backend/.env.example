# COSTTY Backend — Environment Configuration
#
# Copy this file to `.env` for local development, OR paste these values
# directly into Render's "Environment Variables" dashboard for production.

# ── Application ────────────────────────────────────────────
APP_NAME="COSTTY API"
APP_ENV=production
DEBUG=false

# ── Database ───────────────────────────────────────────────
# Supabase Postgres connection string.
# Get from: Supabase Dashboard > Settings > Database > Connection string > URI
#
# Driver scheme MUST be postgresql+psycopg:// (SQLAlchemy + psycopg 3).
# Password with special chars: @ → %40, ! → %21, # → %23, space → %20.
#
# IMPORTANT: use the Transaction pooler (port 6543). The direct connection
# (port 5432) does NOT resolve from Render's network.
#
# Pooler example:
#   DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres.CHANGE_ME:CHANGE_ME@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── Supabase (auth + storage) ──────────────────────────────
# Get from: Supabase Dashboard > Settings > API
# Either the long JWT ("eyJ...") keys OR the new "sb_publishable_/sb_secret_"
# keys both work with supabase-py 2.31+.
SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
SUPABASE_STORAGE_BUCKET=documents

# ── Currency & Pricing (per printed side, in INR) ──────────
CURRENCY=INR
BW_SIMPLEX_PRICE=2.50
BW_DUPLEX_PRICE=2.50
COLOR_SIMPLEX_PRICE=8.00
COLOR_DUPLEX_PRICE=8.00

# ── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production, set this to your Vercel deployment URL.
CORS_ORIGINS=https://CHANGE_ME.vercel.app,http://localhost:5173

# ── Pagination ─────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ── Authentication ──────────────────────────────────────────
# Generate a strong secret: `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── File Storage ───────────────────────────────────────────
STORAGE_BACKEND=supabase
STORAGE_LOCAL_PATH=./storage
MAX_UPLOAD_SIZE_BYTES=52428800
ALLOWED_FILE_EXTENSIONS=pdf,doc,docx,ppt,pptx,xls,xlsx,txt,csv,jpg,jpeg,png,gif,webp,bmp
