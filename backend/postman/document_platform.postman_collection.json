{
  "info": {
    "name": "Document Platform API — Print Estimation + File Management (Audited)",
    "description": "Postman collection for the Print Cost Estimation Service REST API. Import this collection and set the `base_url` variable (defaults to http://127.0.0.1:8000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "estimate_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "admin_api_key",
      "value": "change-me-in-production",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "zeni",
      "type": "string"
    },
    {
      "key": "folder_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "file_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response has status ok', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.status).to.eql('ok');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create Estimate (B&W Duplex)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"page_count\": 100,\n  \"copies\": 2,\n  \"color_mode\": \"bw\",\n  \"print_type\": \"duplex\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/estimates",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "estimates"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.test('Response has estimate_id', function () { pm.expect(json.estimate_id).to.be.a('number'); });",
              "pm.test('Response structure is correct', function () {",
              "    pm.expect(json).to.have.property('page_count');",
              "    pm.expect(json).to.have.property('copies');",
              "    pm.expect(json).to.have.property('color_mode');",
              "    pm.expect(json).to.have.property('print_type');",
              "    pm.expect(json).to.have.property('printed_sides_per_copy');",
              "    pm.expect(json).to.have.property('physical_sheets_per_copy');",
              "    pm.expect(json).to.have.property('total_printed_sides');",
              "    pm.expect(json).to.have.property('total_physical_sheets');",
              "    pm.expect(json).to.have.property('price_per_printed_side');",
              "    pm.expect(json).to.have.property('cost_per_copy');",
              "    pm.expect(json).to.have.property('total_cost');",
              "    pm.expect(json).to.have.property('currency');",
              "});",
              "pm.test('Total cost is correct for 100pg/2copies/BW/duplex', function () {",
              "    pm.expect(parseFloat(json.total_cost)).to.eql(300.00);",
              "    pm.expect(parseFloat(json.cost_per_copy)).to.eql(150.00);",
              "    pm.expect(json.physical_sheets_per_copy).to.eql(50);",
              "});",
              "pm.collectionVariables.set('estimate_id', json.estimate_id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
